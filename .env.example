# Optional local backend storage. Sensitive data must remain outside Git.
# COPILOT_DATA_DIR=./local-data

# Automatic local Live fallback (AI-001B), disabled by default.
# The backend does not auto-load this file; set variables before starting it.
COPILOT_LLM_ENABLED=false
# Required only when enabled: an approved, already installed LOCAL Ollama model.
# COPILOT_OLLAMA_MODEL=your-local-model:tag
COPILOT_LLM_TIMEOUT_SECONDS=8

# Optional local Whisper worker; no installation or model download on startup.
# Prefer an isolated runtime. Use absolute paths set before launching the API.
# COPILOT_WHISPER_PYTHON=C:/path/to/isolated-venv/Scripts/python.exe
# COPILOT_WHISPER_MODEL_DIR=C:/path/to/already-downloaded/faster-whisper-small
