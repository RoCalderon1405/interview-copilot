{
  "name": "interview-copilot-desktop",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,desktop \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint:electron": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/capture-preload.cjs && node --check audio-lab/main.cjs && node --check audio-lab/renderer.js && node --check audio-lab/transcribe.js && node --check audio-lab/pcm-processor.js && node --check public/audio-lab/capture-ui.js && node --check public/ui-language.js",
    "test:electron": "node --test electron/main.test.cjs",
    "test:ui": "node --test src/features/live/LiveSuggestion.test.cjs",
    "lab:audio": "electron ./audio-lab",
    "lab:transcribe": "concurrently -k -n web,stt \"vite --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:5173/audio-lab/transcribe.html && electron ./audio-lab --transcribe\"",
    "test:audio": "node --test audio-lab/pcm-processor.test.cjs audio-lab/transcribe.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.0.0",
    "electron": "^39.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.0"
  }
}
